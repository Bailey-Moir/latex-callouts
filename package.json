{
  "name": "obsidian-sample-plugin",
  "version": "1.0.0",
  "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "scripts": {
    "dev": "npm-run-all --parallel sass:watch dev:esbuild",
    "sass:watch": "sass --watch styles.scss:styles.css",
    "dev:esbuild": "node esbuild.config.mjs",
    "sass": "sass styles.scss styles.css",
    "build": "npm run sass && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "esbuild": "0.17.3",
    "npm-run-all": "^4.1.5",
    "obsidian": "latest",
    "sass": "^1.101.0",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
